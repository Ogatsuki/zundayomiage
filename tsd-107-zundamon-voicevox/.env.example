# Example environment variables
# Copy this file to .env.local for local development
# or .env.docker for Docker environment

# VOICEVOX API endpoint URL (server-side only)
# Local development: http://localhost:50021
# Docker environment: http://voicevox:50021
# Cloud Run: Configure based on your VoiceVox service deployment
VOICEVOX_URL=http://localhost:50021

# Optional: Environment marker for Docker
# DOCKER_ENV=true