  "standard_patterns": {
    "description": "Battle-tested patterns inherited from PVBP, still valuable in FCIS+SMAC",

    "useEffectOnce": {
      "purpose": "Prevent React 18 StrictMode double execution",
      "lines_of_code": 15,
      "usage_context": "Shell layer initialization",
      "code_template": "const useEffectOnce = (effect: () => void | (() => void)) => {\n  const hasRun = useRef(false);\n  useEffect(() => {\n    if (!hasRun.current) {\n      hasRun.current = true;\n      return effect();\n    }\n  }, []);\n};"
    },

    "useClientOnly": {
      "purpose": "Detect client-side environment safely",
      "lines_of_code": 10,
      "usage_context": "Shell layer environment detection",
      "code_template": "const useClientOnly = () => {\n  const [isClient, setIsClient] = useState(false);\n  useEffect(() => setIsClient(true), []);\n  return isClient;\n};"
    },

    "useAbortSafe": {
      "purpose": "Manage AbortController lifecycle correctly",
      "lines_of_code": 30,
      "usage_context": "Shell layer HTTP requests",
      "code_template": "const useAbortSafe = () => {\n  const abortRef = useRef<AbortController>();\n  const isMounted = useRef(true);\n  \n  const getController = () => {\n    if (!abortRef.current) {\n      abortRef.current = new AbortController();\n    }\n    return abortRef.current;\n  };\n  \n  useEffect(() => {\n    return () => {\n      isMounted.current = false;\n      if (abortRef.current && !document.hidden) {\n        abortRef.current.abort();\n      }\n    };\n  }, []);\n  \n  return { getController, isMounted };\n};"
    },

    "useMountedRef": {
      "purpose": "Track component mount state",
      "lines_of_code": 10,
      "usage_context": "Shell layer lifecycle management"
    },

    "useHydrated": {
      "purpose": "Detect SSR/CSR hydration completion",
      "lines_of_code": 12,
      "usage_context": "Shell layer SSR handling"
    }
  },

