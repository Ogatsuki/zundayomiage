# VOICEVOX API設定
# Cloud Run Sidecar環境ではIPv6解決で失敗するため127.0.0.1を使用
NEXT_PUBLIC_VOICEVOX_API_URL=http://127.0.0.1:50021
VOICEVOX_API_URL=http://127.0.0.1:50021

# OCR設定
OCR_LANGUAGE=jpn
MAX_FILE_SIZE_MB=5

# セキュリティ設定
ALLOWED_ORIGINS=http://localhost:3000,https://yourdomain.com
RATE_LIMIT=10

# モックモード（開発用）
NEXT_PUBLIC_MOCK_MODE=false

# 音声処理設定
MP3_BITRATE=128
MP3_CHANNELS=1
MP3_FREQUENCY=22050

# FFmpeg設定（オプション）
FFMPEG_PATH=/usr/bin/ffmpeg

# Application Settings
NODE_ENV=development
PORT=3000

# Telemetry
NEXT_TELEMETRY_DISABLED=1